{
  "trellis": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "{{PYTHON_CMD}} .agent/hooks/inject-workflow-state.py",
        "timeout": 15
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON_CMD}} .agent/hooks/inject-shell-session-context.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
