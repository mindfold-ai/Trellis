{
  "name": "mini-trellis-core",
  "version": "0.3.1",
  "description": "mini-trellis core — mem primitives consumed by the CLI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tiger-zzZ/mini-trellis.git"
  },
  "homepage": "https://github.com/Tiger-zzZ/mini-trellis#readme",
  "bugs": {
    "url": "https://github.com/Tiger-zzZ/mini-trellis/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./mem": {
      "types": "./dist/mem/index.d.ts",
      "import": "./dist/mem/index.js",
      "default": "./dist/mem/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "COPYRIGHT"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm run clean && tsc",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ test/",
    "lint:fix": "eslint src/ test/ --fix",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm test && pnpm run build && cp ../../LICENSE ../../COPYRIGHT ."
  },
  "keywords": [
    "mini-trellis",
    "memory",
    "sdk"
  ],
  "author": "Mindfold LLC",
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^20.17.10",
    "eslint": "^9.18.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.21.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
