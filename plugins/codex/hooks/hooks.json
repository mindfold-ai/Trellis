{
  "description": "Run reviewed Trellis hook runtimes from the plugin while reading state from the active repository.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const p=require('node:path');require(p.join(process.env.PLUGIN_ROOT,'hooks','trellis-codex-dispatch.cjs'))\"",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const p=require('node:path');require(p.join(process.env.PLUGIN_ROOT,'hooks','trellis-codex-dispatch.cjs'))\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^(?:trellis-implement|trellis-check|trellis-research)$",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const p=require('node:path');require(p.join(process.env.PLUGIN_ROOT,'hooks','trellis-codex-dispatch.cjs'))\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
